+
+/* ══════════════════════════════════════════════════════════════════════
+   Lesson board — /learn — "Lecția 1-4" shadowing trainer
+   ══════════════════════════════════════════════════════════════════════ */
+.lesson-page {
+  max-width: 900px;
+  margin: 0 auto;
+  padding: 3rem 2rem 4rem;
+}
+
+.lesson-header { text-align: center; margin-bottom: 1.75rem; }
+.lesson-title {
+  font-family: var(--font-serif);
+  font-size: 1.7rem;
+  font-style: italic;
+  letter-spacing: -.01em;
+  margin-bottom: .35rem;
+}
+.lesson-subhead { font-size: .95rem; color: var(--color-text-secondary); opacity: .7; }
+
+/* ── Lesson tabs (top pill row) ── */
+.lesson-tabs {
+  display: flex;
+  justify-content: center;
+  gap: 10px;
+  margin-bottom: 1.75rem;
+  flex-wrap: wrap;
+}
+.lesson-tab {
+  font-size: 14px;
+  font-weight: 600;
+  font-family: var(--font-sans);
+  padding: 10px 22px;
+  border-radius: 999px;
+  border: 1.5px solid var(--color-border);
+  background: var(--color-surface);
+  color: var(--color-text-secondary);
+  opacity: .55;
+  cursor: pointer;
+  transition: background .15s, border-color .15s, opacity .15s;
+}
+.lesson-tab:not(:disabled):hover { background: var(--color-surface-2); }
+.lesson-tab.active {
+  background: var(--color-text-primary);
+  border-color: var(--color-text-primary);
+  color: #fff;
+  opacity: 1;
+}
+.lesson-tab:disabled { cursor: not-allowed; }
+.lesson-tab-lock { margin-left: 6px; font-size: 12px; }
+
+/* ── Lesson grid (4 columns) ── */
+.lesson-grid {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 14px;
+  margin-bottom: 2rem;
+}
+.lesson-col {
+  border-radius: var(--radius-lg);
+  border: 1.5px solid var(--color-border);
+  background: var(--color-surface);
+  padding: 1.1rem 0.9rem 1.25rem;
+  transition: border-color .2s, background .2s, opacity .2s;
+}
+.lesson-col.is-unlocked {
+  background: color-mix(in srgb, var(--lesson-color) 8%, var(--color-bg));
+  border-color: color-mix(in srgb, var(--lesson-color) 30%, var(--color-border));
+}
+.lesson-col.is-active {
+  border-color: var(--lesson-color);
+  border-width: 2px;
+}
+.lesson-col.is-locked { opacity: .45; }
+
+.lesson-col-head { position: relative; text-align: center; margin-bottom: 1rem; }
+.lesson-ipa-big {
+  font-family: var(--font-serif);
+  font-style: italic;
+  font-weight: 600;
+  font-size: 1.5rem;
+  color: var(--lesson-color);
+}
+.lesson-col.is-locked .lesson-ipa-big { color: var(--color-text-muted); opacity: .5; }
+.lesson-ipa-sub { font-size: .7rem; color: var(--color-text-muted); opacity: .6; margin-top: 2px; }
+.lesson-lock {
+  position: absolute; top: -6px; right: 4px;
+  font-size: 13px; opacity: .6;
+}
+
+.lesson-words { display: flex; flex-direction: column; gap: 7px; }
+.lesson-word {
+  font-size: 13.5px;
+  font-weight: 600;
+  text-align: center;
+  padding: 7px 6px;
+  border-radius: var(--radius-md);
+  border: 1px solid color-mix(in srgb, var(--lesson-color) 35%, var(--color-border));
+  background: color-mix(in srgb, var(--lesson-color) 10%, var(--color-bg));
+  color: var(--lesson-color);
+  transition: box-shadow .15s, transform .15s;
+}
+.lesson-col.is-locked .lesson-word {
+  color: var(--color-text-muted);
+  border-color: var(--color-border-soft);
+  background: transparent;
+}
+.lesson-word.is-current {
+  box-shadow: 0 0 0 2px var(--lesson-color);
+  transform: scale(1.03);
+}
+
+/* ── Shadowing panel ── */
+.shadow-panel {
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-xl);
+  background: var(--color-surface);
+  padding: 1.5rem 1.75rem 1.75rem;
+  text-align: center;
+}
+.shadow-title { font-size: 14px; color: var(--color-text-secondary); margin-bottom: 1rem; }
+
+.shadow-tabs {
+  display: inline-flex;
+  gap: 8px;
+  margin-bottom: 1.5rem;
+}
+.shadow-tab {
+  font-size: 13px;
+  font-weight: 600;
+  font-family: var(--font-sans);
+  padding: 8px 18px;
+  border-radius: 999px;
+  border: 1.5px solid var(--tab-color);
+  background: transparent;
+  color: var(--tab-color);
+  opacity: .5;
+  cursor: pointer;
+  transition: background .15s, color .15s, opacity .15s;
+}
+.shadow-tab:not(:disabled):hover { opacity: .8; }
+.shadow-tab.active {
+  background: var(--tab-color);
+  color: #fff;
+  opacity: 1;
+}
+.shadow-tab:disabled { cursor: not-allowed; }
+
+.shadow-repeat-btn {
+  display: block;
+  margin: 0 auto 1rem;
+  font-size: 14px;
+  font-weight: 700;
+  font-family: var(--font-sans);
+  letter-spacing: .02em;
+  padding: 12px 34px;
+  border-radius: var(--radius-md);
+  border: none;
+  background: var(--color-text-primary);
+  color: #fff;
+  cursor: pointer;
+  transition: opacity .15s;
+}
+.shadow-repeat-btn:hover:not(:disabled) { opacity: .85; }
+.shadow-repeat-btn:disabled { opacity: .6; cursor: wait; }
+
+.shadow-count { font-size: 13px; font-weight: 600; color: var(--color-text-secondary); margin-bottom: 8px; }
+.shadow-progress {
+  width: 100%; max-width: 320px; margin: 0 auto 1rem;
+  height: 5px; border-radius: 3px;
+  background: var(--color-border);
+  overflow: hidden;
+}
+.shadow-progress-fill {
+  height: 100%; border-radius: 3px;
+  background: var(--color-text-primary);
+  transition: width .3s ease;
+}
+.shadow-caption { font-size: 12.5px; color: var(--color-text-muted); opacity: .75; }
+
+@media (max-width: 720px) {
+  .lesson-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
